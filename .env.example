# ==============================================
# instaXoom Environment Configuration Template
# ==============================================

# General
ENVIRONMENT=development
PROJECT_NAME=instaXoom
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Backend & API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
POSTGRES_USER=instaxoom
POSTGRES_PASSWORD=instaxoom_secret_password
POSTGRES_DB=instaxoom_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://instaxoom:instaxoom_secret_password@db:5432/instaxoom_db

# Redis & Rate Limiting
REDIS_HOST=redis
REDIS_PORT=6379
RATE_LIMIT_GENERATIONS_PER_DAY=3
RATE_LIMIT_WINDOW_SECONDS=86400

# Storage (MinIO local / Cloudflare R2 / S3)
STORAGE_PROVIDER=local # Options: local, minio, s3, r2
STORAGE_ENDPOINT=http://storage:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=instaxoom-images
STORAGE_PUBLIC_URL=http://localhost:9000/instaxoom-images

# Inference Microservice (ComfyUI Headless)
COMFYUI_HOST=inference
COMFYUI_PORT=8188
COMFYUI_URL=http://inference:8188
COMFYUI_WS_URL=ws://inference:8188/ws

# Model Configuration
# For HP Workstation (32GB VRAM): FLUX_UNET_NAME=flux1-dev-fp8.safetensors
# For 8GB RTX 4060: FLUX_UNET_NAME=flux1-schnell-Q4_K_S.gguf
FLUX_UNET_NAME=flux1-dev-fp8.safetensors
FLUX_MODEL_NAME=flux1-dev-fp8.safetensors
DEFAULT_STEPS=20
DEFAULT_GUIDANCE=3.5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
